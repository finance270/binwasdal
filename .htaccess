# Cadangan bila docroot container diarahkan ke /app (bukan /app/public).
# Semua permintaan diteruskan ke folder public/.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Lindungi folder yang tidak boleh diakses langsung.
<FilesMatch "\.(sql|json|md|yml|yaml)$">
    Require all denied
</FilesMatch>
